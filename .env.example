# Get your free API key at https://faxzero.com/fax_api.php
FAXZERO_API_KEY=your_api_key_here

# Your sender details
DEFAULT_FROM_NAME=Your Name
DEFAULT_FROM_FAX=your-fax-or-phone-number
DEFAULT_FROM_EMAIL=your-email@example.com

# Server config
PORT=3001

# CORS origin (React dev server)
CORS_ORIGIN=http://localhost:3000

# Free tier limit (FaxZero default: 3/day)
DAILY_FAX_LIMIT=3
