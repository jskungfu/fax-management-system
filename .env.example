# ── Sender Defaults ──
FAX_FROM_NAME=Your Name
FAX_FROM_NUMBER=+15551234567
FAX_FROM_EMAIL=you@gmail.com

# ── Email Fax (RFC 3965) ── FREE, uses your own email
# Works with Gmail, Outlook, any SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# ── SIP/T.38 Fax ── FREE, uses local Asterisk
# Install: sudo apt install asterisk
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=faxuser
AMI_SECRET=your-ami-secret

# ── USB Modem Fax ── FREE, needs ~$10 USB fax modem
MODEM_DEVICE=/dev/ttyUSB0

# ── P2P Relay Mesh ── FREE, decentralized fax relay network
# Nodes discover each other via mDNS (LAN) and bootstrap peers (WAN)
P2P_RELAY_ENABLED=false
P2P_RELAY_PORT=8765
P2P_AREA_CODES=              # Area codes you can deliver to (e.g., 212,718)
P2P_COUNTRY_CODES=1          # Country codes (e.g., 1,44)
P2P_BOOTSTRAP_PEERS=         # Known peers (e.g., peer1.example.com:8765,peer2.example.com:8765)

# ── FaxZero Fallback ── 5 free/day, get key at faxzero.com
FAXZERO_API_KEY=

# ── Flask ──
SECRET_KEY=change-me-in-production
PORT=5000
